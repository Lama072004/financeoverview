<?xml version="1.0" encoding="utf-8"?>
<!-- Offline-App: keine Cloud-Sicherung und keine Übertragung auf andere Geräte.
     Sicherungen laufen ausschließlich über das verschlüsselte Backup in der App. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
